#    send "$target_user\r"
#    }    
#
#    "*password:" {
#    send "$target_pass\r"
#    }    
#}

# ===== 登录 target_host 后 =====
send_user "\nINFO 已进入第一台机器\n"

# ===== 如果有第二跳 =====
if {$has_next == 1} {

    send_user "\nINFO 准备跳转第二台机器: $next_host\n"
   expect "login"
    # 发起 ssh
    send "ssh $next_user@$next_host\r"

    expect {

        # 第一次连接确认
        "yes/no" {
            send "yes\r"
            exp_continue
        }

        # 密码
        "*password:" {
            send "$next_pass\r"
        }

            -re {.*@.*[$#] $} {
        send_user "\nINFO 第二跳登录成功, no pass 🚀\n"
    }

        timeout {
            send_user "\nERROR 第二跳连接失败（未出现 password）\n"
            exit 1
        }
    }

    send_user "\nINFO 第二跳登录成功 🚀\n"
}


interact
